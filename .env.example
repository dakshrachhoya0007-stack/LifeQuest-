# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CLOUD PERSISTENCE:
# Used for real PostgreSQL cloud persistence, Row Level Security, and Supabase Auth.
# Retrieve these from your Supabase Project Settings -> API.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# EXPLICIT AUTH REDIRECT URLS (kept separate between production and preview/dev):
# Production build defaults to the published app URL if omitted; never set localhost here.
VITE_PRODUCTION_APP_URL="https://ais-pre-r2du4mvtn2aid6yh7jjmox-633727409836.asia-east1.run.app"
VITE_PREVIEW_APP_URL="https://ais-dev-r2du4mvtn2aid6yh7jjmox-633727409836.asia-east1.run.app"
